# ScrapDaddy backend configuration — PLACEHOLDERS ONLY.
#
# Copy to .env.local for local development, or paste these as environment
# variables in your host's dashboard (Vercel: Settings → Environment Variables).
# Never commit a file containing real keys. .env* is already in .gitignore.

# ---------------------------------------------------------------------------
# Photo analysis — pick ONE provider with VISION_PROVIDER
#
#   gemini  free tier, no card needed. Key: https://aistudio.google.com/apikey
#   openai  pay per request, needs billing credit. Key: https://platform.openai.com/api-keys
#
# Only the chosen provider's key is read. Check what yours can actually do:
#   GET /api/health?probe=1
# ---------------------------------------------------------------------------
VISION_PROVIDER=gemini

# --- if VISION_PROVIDER=gemini ---
GEMINI_API_KEY=AIza-replace-me
# Must be a multimodal model. The free-tier allowance for your project is shown
# at https://aistudio.google.com/rate-limit
GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- if VISION_PROVIDER=openai ---
# OPENAI_API_KEY=sk-replace-me
# gpt-6-astra (most capable), gpt-6.1-sol (balanced), gpt-6-luna (cheapest)
# OPENAI_VISION_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Help assistant — Groq (required for the chatbot)
# Get a key: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_replace-me

# Groq production chat models: openai/gpt-oss-20b (default, fast),
# openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant.
# Groq's catalogue changes; GET /api/health?probe=1 lists what your key can use.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Payments — Razorpay (optional; vendor subscriptions stay unpaid without it)
# Dashboard: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Subscriptions cannot be activated by a webhook until there is somewhere to
# store them. See api/billing/webhook.js.
# SUBSCRIPTION_STORE_URL=postgres://...

# ---------------------------------------------------------------------------
# Access control and limits
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call this API. Leave unset to allow any
# origin, which is fine while testing but should be set in production.
# Example for a GitHub Pages front end talking to a Vercel backend:
# ALLOWED_ORIGINS=https://mahidhar-2012.github.io

# Per-IP hourly caps. Best effort only — see api/_lib/ratelimit.js.
SCAN_RATE_PER_HOUR=20
CHAT_RATE_PER_HOUR=60
MAX_IMAGE_BYTES=6291456
UPSTREAM_TIMEOUT_MS=25000
