# ScrapHub backend configuration — PLACEHOLDERS ONLY.
#
# Copy to .env.local for local development, or paste these as environment
# variables in your host's dashboard (Vercel: Settings → Environment Variables).
# Never commit a file containing real keys. .env* is already in .gitignore.

# ---------------------------------------------------------------------------
# Photo analysis — pick a provider with VISION_PROVIDER (default: groq)
#
#   groq    DEFAULT. Reuses GROQ_API_KEY below, so no extra key and no billing.
#   gemini  free tier, separate key: https://aistudio.google.com/apikey
#   openai  pay per request, needs billing credit on the account.
#
# Only the chosen provider's key is read. See what yours can do:
#   GET /api/health?probe=1
# ---------------------------------------------------------------------------
VISION_PROVIDER=groq

# --- if VISION_PROVIDER=groq (no extra key needed) ---
# Groq's vision-capable model. meta-models/muse-spark-open also does images but
# is limited preview and needs Groq to grant access.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- if VISION_PROVIDER=gemini ---
# GEMINI_API_KEY=AIza-replace-me
# GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- if VISION_PROVIDER=openai ---
# OPENAI_API_KEY=sk-replace-me
# gpt-6-astra (most capable), gpt-6.1-sol (balanced), gpt-6-luna (cheapest)
# OPENAI_VISION_MODEL=gpt-6.1-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Help assistant — Groq (required for the chatbot)
# Get a key: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=gsk_replace-me

# Groq production chat models: openai/gpt-oss-20b (default, fast),
# openai/gpt-oss-120b, llama-3.3-70b-versatile, llama-3.1-8b-instant.
# Groq's catalogue changes; GET /api/health?probe=1 lists what your key can use.
GROQ_CHAT_MODEL=openai/gpt-oss-20b

# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Accounts, email sign-in and sessions
#
# All five are needed together. Without them the app falls back to accounts
# stored in each browser, and /api/health reports mode "browser-only".
#
# 1. Supabase (free): https://supabase.com -> New project
#    Then run db/schema.sql in the SQL Editor.
#    URL and service role key: Project Settings -> API
#    The SERVICE ROLE key bypasses row level security. Server-side only.
#    Never put it in client code or a public variable.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# 2. Resend (free, 3000 emails a month): https://resend.com/api-keys
#    EMAIL_FROM must be a verified sender. onboarding@resend.dev works for
#    testing but only delivers to your own signup address.
RESEND_API_KEY=re_replace-me
EMAIL_FROM=ScrapHub <onboarding@resend.dev>

# 3. A long random string, used to hash one-time codes and session tokens.
#    Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#    Changing it signs everyone out and invalidates outstanding codes.
AUTH_SECRET=replace-me-with-a-long-random-string

# Tuning (optional)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_15MIN=3
SESSION_DAYS=30
# RESEND_BASE_URL=https://api.resend.com

# ---------------------------------------------------------------------------
# Payments — Razorpay (optional; vendor subscriptions stay unpaid without it)
# Dashboard: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Subscriptions cannot be activated by a webhook until there is somewhere to
# store them. See api/billing/webhook.js.
# SUBSCRIPTION_STORE_URL=postgres://...

# ---------------------------------------------------------------------------
# Access control and limits
# ---------------------------------------------------------------------------
# Comma-separated origins allowed to call this API. Leave unset to allow any
# origin, which is fine while testing but should be set in production.
# Example for a GitHub Pages front end talking to a Vercel backend:
# ALLOWED_ORIGINS=https://scraphub.vercel.app

# Per-IP hourly caps. Best effort only — see api/_lib/ratelimit.js.
SCAN_RATE_PER_HOUR=20
CHAT_RATE_PER_HOUR=60
MAX_IMAGE_BYTES=6291456
UPSTREAM_TIMEOUT_MS=25000
